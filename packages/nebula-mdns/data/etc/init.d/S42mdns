#!/bin/sh

MDNS=/usr/sbin/mdns-announce
SSHD_CONF=/etc/ssh/sshd_config
HOST=nebula.local
LABEL=Nebula
PID=/var/run/mdns-announce.pid

start() {
	echo "starting mdns-announce ($HOST)..."
	if [ -f $PID ] && kill -0 `cat $PID` 2>/dev/null; then
		echo "mdns-announce already running"
		return
	fi
	PORT=`awk '/^Port /{print $2}' $SSHD_CONF 2>/dev/null | tail -1`
	PORT=${PORT:-22}
	$MDNS -n $HOST -s $LABEL -p $PORT >/dev/null 2>&1 &
	echo $! > $PID
	}

stop() {
	echo "stopping mdns-announce..."
	[ -f $PID ] && kill `cat $PID` 2>/dev/null
	rm -f $PID
	}

status() {
	if [ -f $PID ] && kill -0 `cat $PID` 2>/dev/null; then
		echo "mdns-announce is running, PID `cat $PID`"
	else
		echo "mdns-announce is not running"
	fi
	}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	status)  status ;;
	*)       echo "Usage: $0 (start|stop|restart|status)"; exit 1 ;;
esac

exit 0
